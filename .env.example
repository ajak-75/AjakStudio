# ---------------------------------------------------------------------------
# GLOBAL DIGITAL UNIVERSE — environment template
# Copy to `.env.local` for local work; set the same names in Cloudflare Pages →
# Settings → Environment variables (Production and Preview) before the first
# deploy. Nothing here is a secret except by accident: only public values.
# ---------------------------------------------------------------------------

# Canonical origin used by canonical links and Open Graph tags.
# Leave empty during development; absolute URLs fall back to localhost.
NEXT_PUBLIC_SITE_URL=

# Supabase Free project (Project settings → API).
# The anon key is public by design — Row Level Security decides access.
# Leaving these empty is supported: the site renders src/config/brand.ts seeds.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "production" | "preview" | "development" — informational only.
NEXT_PUBLIC_SITE_ENV=development

# ---------------------------------------------------------------------------
# Deliberately absent:
#   SUPABASE_SERVICE_ROLE_KEY
# This project has no trusted server runtime (static export on Cloudflare
# Pages Free). A service-role key in a static bundle would grant full database
# access to anyone who reads the JavaScript. Never add it here.
# ---------------------------------------------------------------------------
